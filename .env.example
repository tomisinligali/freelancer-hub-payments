# Database
DATABASE_URL="postgresql://user:password@localhost:5432/freelancer_hub?schema=public"

# NextAuth
NEXTAUTH_SECRET="generate-a-random-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# App
# Base URL used to build verification links (defaults to NEXTAUTH_URL)
APP_URL="http://localhost:3000"

# SMTP (Nodemailer) — Gmail setup.
# Use a Gmail App Password (Google Account > Security > 2-Step Verification >
# App passwords). For other providers, change SMTP_HOST/PORT/SECURE accordingly.
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="YOUR_EMAIL@gmail.com"
SMTP_PASS="YOUR_APP_PASSWORD"
MAIL_FROM="Freelancer Hub <YOUR_EMAIL@gmail.com>"

# Flutterwave — TEST MODE ONLY.
# Test keys come from your Flutterwave dashboard (Settings > API).
# Never put live/production keys here in this slice.
FLW_SECRET_KEY_TEST="FLWSECK_TEST-your-test-secret-key"
FLW_PUBLIC_KEY_TEST="FLWPUBK_TEST-your-test-public-key"
# Secret hash for verifying webhook signatures. Set the same value on a webhook
# URL pointing at /api/webhooks/flutterwave in the dashboard. Any random string.
FLW_WEBHOOK_HASH="your-random-webhook-hash"
# API base (v3). Leave as-is.
FLW_BASE_URL="https://api.flutterwave.com/v3"
# Payment-plan ids, created once via: npx tsx scripts/setup-flutterwave-plans.ts
FLW_MONTHLY_PLAN_ID=""
FLW_YEARLY_PLAN_ID=""
